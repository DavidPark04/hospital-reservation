# Copy to the ignored root .env for local use. Process environment wins.
# Empty values use launcher defaults. Never put server secrets in VITE_ variables.
# Local defaults: MongoDB 127.0.0.1:27118/MediPick, frontend 127.0.0.1:5174, backend 127.0.0.1:18081.
# On Vercel set both APP_* URLs to https://medi-pick.vercel.app.
MONGODB_URI=
JWT_SECRET=
APP_FRONTEND_URL=
APP_BACKEND_URL=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
KAKAO_CLIENT_ID=
KAKAO_CLIENT_SECRET=
# Public Kakao Maps JavaScript key only; restricted by registered SDK domains.
# The integrated local launcher passes this to Vite. Standalone Vite uses frontend/.env.local.
VITE_KAKAO_MAP_JS_KEY=
OPENAI_API_KEY=
# Default: gpt-6.2-sol
OPENAI_MODEL=
HIRA_HOSPITAL_KEY=
HIRA_DETAIL_KEY=
COMWEL_API_KEY=
# Gmail SMTP app password belongs only in server environment settings.
SMTP_USERNAME=
SMTP_PASSWORD=
# Firebase browser configuration is served by the verification config API.
FIREBASE_API_KEY=
FIREBASE_AUTH_DOMAIN=
FIREBASE_PROJECT_ID=
# Optional path to a local API key file. Environment keys take priority by default.
HOSPITAL_API_FILE=
# Set to api-file to use the OpenAI key from that file even when Windows supplies another.
HOSPITAL_OPENAI_KEY_SOURCE=
# Local launcher defaults: 18081 and 127.0.0.1. Container defaults: PORT=8080 and 0.0.0.0.
SERVER_PORT=
SERVER_ADDRESS=
PORT=
# Set framework only when behind the trusted deployment proxy. Local default: none.
SERVER_FORWARD_HEADERS_STRATEGY=
# Default: true. Seeds sample hospitals only, never users or administrator passwords.
DEMO_ENABLED=
